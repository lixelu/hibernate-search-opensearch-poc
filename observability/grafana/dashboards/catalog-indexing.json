    {
      "id": 9,
      "title": "Hibernate Search processor health",
      "description": "Hibernate Search publishes no metrics of its own \u2014 no Micrometer classes in any of its jars, and no monitoring section in the 7.2 or 8.0 reference docs \u2014 so its processor is observed through the agent table it maintains. Each agent renews its lease every 2s (pulse_interval) for a 30s window (pulse_expiration), both measured. One RUNNING agent per instance is normal. An expired lease means a processor has been silent for over 30 seconds: its shard stays assigned, its share of the backlog stops draining, and nothing else in the system says why. Alert on it.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "catalog_hs_agents",
          "legendFormat": "{{state}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "catalog_hs_agents_expired",
          "legendFormat": "expired lease",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stepAfter": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "expired lease"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Who resolved the fan-out",
      "description": "Queue rows the application wrote by hand, against documents each pipeline actually indexed. The hand-rolled pipeline is keyed by product id and cannot discover a category change, so its fan-out is written explicitly as one INSERT \u2026 SELECT. Hibernate Search resolves its own from a single Category event, which is why no queue-row line appears for it and its indexing still rises.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pipeline)(increase(catalog_outbox_events_written_total[1m]))",
          "legendFormat": "queue rows written \u2014 {{pipeline}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (pipeline)(increase(catalog_index_writes_total[1m]))",
          "legendFormat": "documents indexed \u2014 {{pipeline}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
