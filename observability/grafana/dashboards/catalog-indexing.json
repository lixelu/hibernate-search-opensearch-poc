    {
      "id": 12,
      "title": "ORM cost of indexing \u2014 entities loaded per document written",
      "description": "Hibernate Search builds each document by loading the entity graph through Hibernate ORM, and this is what that costs. Measured at 7.5 entity loads and 4.8 collection loads per document \u2014 which is why its mass indexer runs about 6x slower than a hand-written batched key lookup, and why it adds ~13 MySQL statements per write against ~2.9 for the outbox pipeline. Caveat: ORM statistics are global and cannot distinguish the event processor from ordinary application queries, so this ratio is only clean when indexing dominates \u2014 during a fan-out, for instance.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(hibernate_entities_loads_total[5m])) / on() group_left() clamp_min(sum(increase(catalog_index_writes_total{pipeline=\"hibernate-search\"}[5m])), 1)",
          "legendFormat": "entity loads per document",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(hibernate_collections_loads_total[5m])) / on() group_left() clamp_min(sum(increase(catalog_index_writes_total{pipeline=\"hibernate-search\"}[5m])), 1)",
          "legendFormat": "collection loads per document",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
