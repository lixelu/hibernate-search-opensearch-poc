    {
      "id": 13,
      "title": "Abandoned indexing work",
      "description": "The failure mode that has no other symptom. Hibernate Search retries a failed event twice and then marks it ABORTED (reference doc 19.3.8): nothing retries it again, nothing escalates, and the index is permanently wrong for those entities. Measured here: a 30-second OpenSearch outage abandoned all 1,740 events from one category rename. The red line is the backlog of abandoned work and should be flat at zero; any step up is a page. The failure rate is the leading indicator that arrives about 30 seconds earlier, and it exists only because a FailureHandler is configured -- the default writes an ERROR log and increments nothing. Recover with POST /api/admin/hs/aborted/reprocess once the cause is fixed.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "catalog_outbox_aborted{pipeline=\"hibernate-search\"}",
          "legendFormat": "events abandoned",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(catalog_hs_failures_entities_total[1m])",
          "legendFormat": "entities failing/s",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(catalog_hs_failures_total[1m])",
          "legendFormat": "failures/s ({{kind}})",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
