{
  "uid": "catalog-indexing",
  "title": "Catalog indexing and fan-out",
  "description": "What each user change costs the indexing pipelines, and where a shared-parent fan-out shows up.",
  "tags": [
    "catalog",
    "opensearch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Indexing amplification \u2014 documents indexed per user change (5m)",
      "description": "The fan-out, in one number: documents written to each index divided by the user-level changes that caused them, counted over five minutes. Ordinary product writes sit near 1. A change to a shared parent lifts it sharply \u2014 renaming a category with 3,079 products inside a window of ~100 other writes reads about 31. Counted with increase() over a window rather than rate(): a rate over a single event collapses the denominator and produces a meaningless ratio.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pipeline) (increase(catalog_index_writes_total[5m])) / on() group_left() clamp_min(sum(increase(catalog_write_mutations_total[5m])), 1)",
          "legendFormat": "{{pipeline}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
